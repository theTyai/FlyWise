# FlyWise AI - settings for every service, in one file.
#
# "npm run setup" copies this file to ".env" and fills in random secrets for you.
# To do it by hand: copy it to ".env" in this same folder and change the four secrets.
# The real .env is listed in .gitignore - never commit it.

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/flywise_db

# ---- Ports and URLs (development defaults) ----
USER_BACKEND_PORT=5000
ADMIN_BACKEND_PORT=5001
USER_BACKEND_URL=http://localhost:5000
ADMIN_BACKEND_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:8000
USER_FRONTEND_ORIGIN=http://localhost:5173
ADMIN_FRONTEND_ORIGIN=http://localhost:5174

# Where the two frontends find their APIs. Only names starting with VITE_ are visible
# to browser code. Change these if you change the backend ports above.
VITE_API_URL=http://localhost:5000/api/v1
VITE_ADMIN_API_URL=http://localhost:5001/api/v1/admin

# ---- Secrets ("npm run setup" replaces these four with random values) ----
USER_JWT_SECRET=change-me-user-access-secret
USER_REFRESH_SECRET=change-me-user-refresh-secret
ADMIN_JWT_SECRET=change-me-admin-secret
# Shared key for service-to-service calls (backends <-> each other, backends -> AI service)
INTERNAL_SERVICE_KEY=change-me-internal-key

# ---- First admin account (created on admin-backend start if no admin exists) ----
ADMIN_NAME=Desk Admin
ADMIN_EMAIL=admin@flywise.local
ADMIN_PASSWORD=ChangeMe!2026

# ---- Flight data ----
# mock   = generated sample fares, always labelled as sample data in the UI
# duffel = live offers from the Duffel API (needs DUFFEL_ACCESS_TOKEN)
FLIGHT_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=

# ---- AI recommendation service ----
# none      = scoring formula + template explanations (no API key needed)
# anthropic = Claude writes the explanations and picks "best overall"
# openai    = any OpenAI-compatible chat completions endpoint
LLM_PROVIDER=none
LLM_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Seconds to wait for the LLM before falling back to template explanations
LLM_TIMEOUT_SECONDS=12
# Ranking weights for "best overall" (must be positive; they are normalised)
WEIGHT_PRICE=0.50
WEIGHT_DURATION=0.35
WEIGHT_STOPS=0.15
