# FlyWise AI — Environment Configuration Template
# "npm run setup" copies this file to ".env" with random secrets.

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/flywise_db

# ---- Ports and URLs ----
USER_BACKEND_PORT=5000
ADMIN_BACKEND_PORT=5001
USER_BACKEND_URL=http://localhost:5000
ADMIN_BACKEND_URL=http://localhost:5001
AI_SERVICE_URL=http://localhost:8000
USER_FRONTEND_ORIGIN=http://localhost:5173
ADMIN_FRONTEND_ORIGIN=http://localhost:5174

# Frontend API addresses (Vite exposes VITE_* to browser code)
VITE_API_URL=http://localhost:5000/api/v1
VITE_ADMIN_API_URL=http://localhost:5001/api/v1/admin

# ---- Security & Authentication Secrets ----
USER_JWT_SECRET=replace_with_random_secret_at_least_32_chars
USER_REFRESH_SECRET=replace_with_random_secret_at_least_32_chars
ADMIN_JWT_SECRET=replace_with_random_secret_at_least_32_chars
INTERNAL_SERVICE_KEY=replace_with_random_secret_at_least_32_chars

# ---- Initial Desk Administrator Credentials ----
ADMIN_NAME=Desk Admin
ADMIN_EMAIL=admin@flywise.local
ADMIN_PASSWORD=ChangeMe!2026

# ---- Flight Data Engine ----
# real_schedule = Authentic airline schedules (IndiGo, Air India, Vistara, Akasa, SpiceJet) - Free, no paid tokens required
# mock          = Synthetic generated fares for local offline development
FLIGHT_PROVIDER=real_schedule

# ---- AI Recommendation Service ----
# LLM_PROVIDER: none (deterministic scoring + template explanations, free, no API key required)
#               anthropic (uses Claude for natural language reasoning)
#               openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=none
LLM_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12

# Recommendation Weights (Price 50%, Duration 35%, Stops 15%)
WEIGHT_PRICE=0.50
WEIGHT_DURATION=0.35
WEIGHT_STOPS=0.15
